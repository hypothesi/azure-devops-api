{
   "name": "@hypothesi/azure-devops-openapi",
   "version": "0.1.0",
   "description": "Azure DevOps REST API specs as strict OpenAPI 3.2, with a compatibility manifest of API versions and products",
   "keywords": [
      "ado",
      "azure-devops",
      "openapi",
      "rest",
      "swagger"
   ],
   "homepage": "https://github.com/hypothesi/azure-devops-api/tree/main/packages/openapi#readme",
   "bugs": {
      "url": "https://github.com/hypothesi/azure-devops-api/issues"
   },
   "license": "MIT",
   "author": "Matt Luedke",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/hypothesi/azure-devops-api.git",
      "directory": "packages/openapi"
   },
   "files": [
      "dist/openapi",
      "dist/manifest.json",
      "dist/manifest.js",
      "dist/manifest.d.ts",
      "dist/manifest.cjs",
      "dist/manifest.d.cts",
      "NOTICE"
   ],
   "type": "module",
   "sideEffects": false,
   "exports": {
      "./manifest": {
         "import": "./dist/manifest.js",
         "require": "./dist/manifest.cjs"
      },
      "./manifest.json": "./dist/manifest.json",
      "./openapi/*": "./dist/openapi/*",
      "./package.json": "./package.json"
   },
   "scripts": {
      "coverage": "vp test run --project node --coverage",
      "fetch": "node scripts/fetch.ts",
      "test": "vp test run",
      "test:node": "vp test run --project node"
   },
   "devDependencies": {
      "@redocly/cli": "2.79.0",
      "@scalar/openapi-upgrader": "0.4.11",
      "zod": "4.6.7"
   },
   "peerDependencies": {
      "zod": "^4.0.0"
   },
   "engines": {
      "node": ">=22.18.0"
   }
}
