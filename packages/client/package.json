{
   "name": "@hypothesi/azure-devops-api",
   "version": "0.1.0",
   "description": "Type-safe Azure DevOps REST API client for browsers and Node.js, with Zod-validated responses, timeouts, and retries",
   "keywords": [
      "ado",
      "api",
      "azure-devops",
      "client",
      "rest",
      "typescript",
      "work-items",
      "zod"
   ],
   "homepage": "https://github.com/hypothesi/azure-devops-api/tree/main/packages/client#readme",
   "bugs": {
      "url": "https://github.com/hypothesi/azure-devops-api/issues"
   },
   "license": "MIT",
   "author": "Matt Luedke",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/hypothesi/azure-devops-api.git",
      "directory": "packages/client"
   },
   "files": [
      "dist"
   ],
   "type": "module",
   "sideEffects": false,
   "main": "./dist/index.cjs",
   "module": "./dist/index.js",
   "types": "./dist/index.d.cts",
   "exports": {
      ".": {
         "import": "./dist/index.js",
         "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
   },
   "scripts": {
      "build": "vp pack",
      "test": "vp test run",
      "test:node": "vp test run --project node",
      "test:watch": "vp test"
   },
   "devDependencies": {
      "zod": "4.6.7"
   },
   "peerDependencies": {
      "zod": "^4.0.0"
   },
   "engines": {
      "node": ">=22.18.0"
   }
}
