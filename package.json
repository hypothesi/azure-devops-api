{
   "name": "@hypothesi/azure-devops-api",
   "version": "0.1.0",
   "description": "Type-safe Azure DevOps REST API client for browsers and Node.js, with Zod-validated responses, timeouts, and retries",
   "keywords": [
      "ado",
      "api",
      "azure-devops",
      "client",
      "rest",
      "typescript",
      "work-items",
      "zod"
   ],
   "homepage": "https://github.com/hypothesi/azure-devops-api#readme",
   "bugs": {
      "url": "https://github.com/hypothesi/azure-devops-api/issues"
   },
   "license": "MIT",
   "author": "Matt Luedke",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/hypothesi/azure-devops-api.git"
   },
   "files": [
      "dist"
   ],
   "type": "module",
   "sideEffects": false,
   "main": "./dist/index.cjs",
   "module": "./dist/index.js",
   "types": "./dist/index.d.cts",
   "exports": {
      ".": {
         "import": "./dist/index.js",
         "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
   },
   "scripts": {
      "build": "vp pack",
      "check": "vp check",
      "check:fix": "vp check --fix",
      "standards": "vp check && npm run lint:md && vp pack",
      "test": "vp test run",
      "test:watch": "vp test",
      "prepublishOnly": "npm run standards && npm test",
      "lint:md": "markdownlint-cli2 \"**/*.md\"",
      "test:node": "vp test run --project node"
   },
   "devDependencies": {
      "@arethetypeswrong/core": "0.18.5",
      "@vitest/browser-playwright": "5.1.0",
      "markdownlint-cli2": "0.24.0",
      "playwright": "1.64.1",
      "publint": "0.3.25",
      "typescript": "7.0.2",
      "vite-plus": "1.5.0",
      "zod": "4.6.7"
   },
   "peerDependencies": {
      "zod": "^4.0.0"
   },
   "engines": {
      "node": ">=22.18.0"
   }
}
