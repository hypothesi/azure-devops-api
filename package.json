{
   "name": "azure-devops-api-monorepo",
   "private": true,
   "license": "MIT",
   "workspaces": [
      "packages/*",
      "apps/*"
   ],
   "type": "module",
   "scripts": {
      "build": "vp run -r build",
      "check": "vp check",
      "check:fix": "vp check --fix",
      "lint:md": "markdownlint-cli2 \"**/*.md\"",
      "standards": "vp check && npm run lint:md && vp run -r build",
      "test": "vp run -r test",
      "test:node": "vp run -r test:node"
   },
   "devDependencies": {
      "@arethetypeswrong/core": "0.18.5",
      "@vitest/browser-playwright": "5.1.0",
      "markdownlint-cli2": "0.24.0",
      "playwright": "1.64.1",
      "publint": "0.3.25",
      "typescript": "7.0.2",
      "vite-plus": "1.5.0"
   },
   "engines": {
      "node": ">=22.18.0"
   }
}
